# ── LLM ──────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ── BASE DE DONNÉES ───────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=hybrid_ai_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql://postgres:changeme@localhost:5432/hybrid_ai_db

# ── QDRANT ────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=                    # Vide pour local, requis pour cloud EU

# ── MLFLOW ────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=hybrid_ai_platform

# ── LANGSMITH ─────────────────────────────────────────
LANGCHAIN_API_KEY=ls__...
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=hybrid-ai-platform

# ── API ───────────────────────────────────────────────
API_SECRET_KEY=changeme_secret_key_min_32_chars
API_ALGORITHM=HS256
API_ACCESS_TOKEN_EXPIRE_MINUTES=60
API_HOST=0.0.0.0
API_PORT=8000

# ── DOMAINE APPLICATIF ────────────────────────────────
# Options: telecom | finance | industry
DOMAIN=telecom

# ── FEEDBACK LOOP ─────────────────────────────────────
FEEDBACK_ERROR_THRESHOLD=0.15     # Seuil RMSE pour déclencher le feedback
FEEDBACK_CONSECUTIVE_PERIODS=5    # Nombre de périodes consécutives avant alerte
